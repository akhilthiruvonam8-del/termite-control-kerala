# VeeduX Environment Configuration
# Copy this file to .env.local or .env for local development:
#   cp .env.example .env.local

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Project Settings -> API -> Project API keys -> anon public)
# IMPORTANT: Use ONLY the public 'anon' key here.
# NEVER expose the 'service_role' secret key in client-side code or Vite environment variables!
VITE_SUPABASE_ANON_KEY=your-anon-public-key
